    {
      "id": "tDmFtgx9b0JEKpWJp5gH7",
      "type": "text",
      "x": 8204.913941025978,
      "y": 309.6298743018633,
      "width": 1559.5206298828125,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7p",
      "roundness": null,
      "seed": 776670723,
      "version": 761,
      "versionNonce": 823624397,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1729190764055,
      "link": null,
      "locked": false,
      "text": "A blob is what we need to have to realize a model.\n\nCurrently, there is no object that represents this blob.\nThe ModelDescr is a proxy for the blob. \n\nThe ModelDescr should be a standalone\nentity that represents fully a model.\n\nCurrently because we include under the same object both\nmetadata, validation data, and model functional requirements e.g. weights + architecture,\nwould make a redesigned ModelDescr heavy on memory.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A blob is what we need to have to realize a model.\n\nCurrently, there is no object that represents this blob.\nThe ModelDescr is a proxy for the blob. \n\nThe ModelDescr should be a standalone\nentity that represents fully a model.\n\nCurrently because we include under the same object both\nmetadata, validation data, and model functional requirements e.g. weights + architecture,\nwould make a redesigned ModelDescr heavy on memory.",
      "autoResize": true,
      "lineHeight": 1.25
    },
