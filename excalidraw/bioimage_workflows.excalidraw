      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 729.739013671875,
      "height": 630,
      "seed": 1934369933,
      "groupIds": [
        "hZ-B9e_7MCq5xLX53A7oi",
